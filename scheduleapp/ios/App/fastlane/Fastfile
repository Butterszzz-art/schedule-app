default_platform(:ios)

# Builds the Capacitor-wrapped app and uploads it to TestFlight. Run from
# CI (see .github/workflows/testflight.yml) or locally once you have Xcode:
#   APPLE_TEAM_ID=... APP_STORE_CONNECT_API_KEY_ID=... \
#   APP_STORE_CONNECT_API_ISSUER_ID=... APP_STORE_CONNECT_API_KEY_CONTENT=... \
#   BUILD_NUMBER=1 bundle exec fastlane beta
#
# Uses an App Store Connect API key (not fastlane match) for code signing,
# so Xcode manages certificates/profiles automatically on the CI machine --
# no separate certificates repo to maintain. The API key needs at least the
# "App Manager" role in App Store Connect -> Users and Access -> Integrations.
platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT"),
      is_key_content_base64: true,
    )

    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: ENV.fetch("BUILD_NUMBER"),
    )

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "App.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
