// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  password        String
  createdAt       DateTime         @default(now())
  logs            DayLog[]
  weekOverrides   WeekOverride[]
  settings        UserSettings?
  tasks           Task[]
  taskCompletions TaskCompletion[]
  routineItems    RoutineItem[]
  checklist       ChecklistEntry[]
  extraTasks      ExtraTask[]
  workLogs        WorkLog[]
  workShifts      WorkShift[]
}

model UserSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  semester      Int      @default(1) // 1 or 2
  // Authenticates the public iCal feed URL (/api/calendar/[token].ics)
  // without requiring login -- treat it like an API key.
  calendarToken String   @unique @default(cuid())
  updatedAt     DateTime @updatedAt
}

// LEGACY (timed-schedule era): DayLog, WeekOverride, BlockAdjustment,
// Task and TaskCompletion are no longer read or written since the switch
// to the daily checklist. Kept so the old history isn't lost; safe to drop
// in a later migration.

// A single logged block for a specific date
model DayLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      String // ISO date: "2026-09-01"
  blockId   String // matches id in schedule data e.g. "s1m-gym"
  status    String // "done" | "skipped"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, blockId])
  @@index([userId, date])
}

// Per-week block toggles (disabled blocks for a specific ISO week)
model WeekOverride {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  weekKey   String // ISO week: "2026-W38"
  dayKey    String // "Mon" | "Tue" | ...
  blockId   String // block to disable
  disabled  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, weekKey, dayKey, blockId])
  @@index([userId, weekKey])
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String // ISO date
  weight    Float // kg
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

// Adjusted block times for a specific day (when user pushes +15m)
model BlockAdjustment {
  id        String   @id @default(cuid())
  userId    String
  date      String // ISO date
  blockId   String
  startMins Int // adjusted start in minutes from midnight
  createdAt DateTime @default(now())

  @@unique([userId, date, blockId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Dedup marker so the notify cron doesn't re-send a reminder for the
// same block on the same day every time it ticks.
model NotifiedBlock {
  id        String   @id @default(cuid())
  userId    String
  date      String // ISO date
  blockId   String
  createdAt DateTime @default(now())

  @@unique([userId, date, blockId])
}

// ── Tasks tab: weekly planner + daily checklist ──────────────────────────
// School / Content / Websites / Personal task tracking, separate from the
// schedule blocks above. A Task belongs to one (weekKey, dayKey, category)
// slot; completion is tracked per calendar date via TaskCompletion, so
// toggling done/undone is just create/delete on that join row.
model Task {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  weekKey     String // ISO week: "2026-W38"
  dayKey      String // "Mon" | "Tue" | ... | "Sun"
  category    String // "school" | "content" | "websites" | "personal"
  text        String
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  completions TaskCompletion[]

  @@index([userId, weekKey, dayKey])
  @@index([userId, weekKey])
}

model TaskCompletion {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        String // ISO date: "2026-09-01"
  completedAt DateTime @default(now())

  @@unique([taskId, date])
  @@index([userId, date])
}

// ── Daily checklist ──────────────────────────────────────────────────────
// The app is a flexible daily checklist: no clock times, just what needs
// doing each day. A RoutineItem is one line on that list, per schedule
// mode (prep/normal), seeded from lib/checklist/defaults.ts the first time
// a mode is used and then editable in the Routine tab.
model RoutineItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  mode      String // "prep" | "normal"
  key       String // stable id, e.g. "posing"; custom items get "custom-<cuid>"
  area      String // "anchors" | "body" | "fuel" | "mind" | "content" | "life"
  kind      String // block-kind colour key, see lib/schedule/colors.ts
  label     String
  hint      String   @default("")
  type      String   @default("check") // "check" | "count" | "chunks"
  target    Int      @default(1) // count items: how many (e.g. 5 meals)
  chunks    String[] @default([]) // chunk items: e.g. ["2h", "1.5h"]
  days      Int[] // 0 = Mon ... 6 = Sun
  order     Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mode, key])
  @@index([userId, mode])
}

// Progress on one checklist item on one date. `value` depends on the
// item's type: check = 1, count = how many done, chunks = bitmask of the
// chunks done. No row = nothing done yet.
model ChecklistEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      String // ISO date
  itemKey   String // RoutineItem.key, or "uni:<session id>"
  value     Int
  updatedAt DateTime @updatedAt

  @@unique([userId, date, itemKey])
  @@index([userId, date])
}

// One-off tasks with no time slot. scope "day": for one date ("Also
// today"). scope "week": for the whole ISO week, `date` is that week's
// Monday ("This week"). Unfinished ones roll over (onto today / into the
// current week) until ticked off; doneOn records the day that happened.
model ExtraTask {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      String // ISO date it was added for (week scope: that week's Monday)
  scope     String   @default("day") // "day" | "week"
  label     String
  doneOn    String? // ISO date it was ticked off
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([userId, doneOn])
}

// LEGACY: per-day side-job hours, replaced by WorkShift on 2026-10-10.
model WorkLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  date   String // ISO date
  hours  Float

  @@unique([userId, date])
}

// One side-job shift. Hours are derived from start/end ("HH:MM", an end
// before the start means the shift runs past midnight). Target 12-16h/week.
model WorkShift {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      String // ISO date the shift starts on
  start     String // "HH:MM"
  end       String // "HH:MM"
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, date])
}
