// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  password     String
  createdAt    DateTime         @default(now())
  settings     UserSettings?
  areas        UserArea[]
  routineItems RoutineItem[]
  checklist    ChecklistEntry[]
  extraTasks   ExtraTask[]
  goals        Goal[]
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  // Authenticates the public iCal feed URL (/api/calendar/[token].ics)
  // without requiring login -- treat it like an API key.
  calendarToken      String   @unique @default(cuid())
  // Gates Today/Week/Routine behind /onboarding for a brand-new account
  // (one with no areas yet). Set true once they finish or skip it.
  onboardingComplete Boolean  @default(false)
  // "HH:MM", 24h. The one daily push (see lib/notify.ts) fires in a short
  // window starting here, if anything on that day's list is still open.
  reminderTime       String   @default("20:30")
  updatedAt          DateTime @updatedAt
}

// A user-defined checklist area (e.g. "Health", "Work"). Areas are fully
// user-configurable -- there's no fixed/locked set. `kind` picks the
// colour, see lib/schedule/colors.ts.
model UserArea {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  key       String // stable slug, derived from label at creation time
  label     String
  kind      String
  order     Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Dedup marker so the notify cron doesn't re-send a reminder for the
// same block on the same day every time it ticks.
model NotifiedBlock {
  id        String   @id @default(cuid())
  userId    String
  date      String // ISO date
  blockId   String
  createdAt DateTime @default(now())

  @@unique([userId, date, blockId])
}

// ── Daily checklist ──────────────────────────────────────────────────────
// The app is a flexible daily checklist: no clock times, just what needs
// doing each day. A RoutineItem is one line on that list, created by the
// user (via onboarding or the Routine tab) and belonging to one UserArea.
model RoutineItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  key       String // stable id; custom items get "custom-<cuid>"
  area      String // UserArea.key
  kind      String // block-kind colour key, see lib/schedule/colors.ts
  label     String
  hint      String   @default("")
  type      String   @default("check") // "check" | "count" | "chunks"
  target    Int      @default(1) // count items: how many (e.g. 5 meals)
  chunks    String[] @default([]) // chunk items: e.g. ["2h", "1.5h"]
  days      Int[] // 0 = Mon ... 6 = Sun
  order     Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// Progress on one checklist item on one date. `value` depends on the
// item's type: check = 1, count = how many done, chunks = bitmask of the
// chunks done. No row = nothing done yet.
model ChecklistEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      String // ISO date
  itemKey   String // RoutineItem.key
  value     Int
  updatedAt DateTime @updatedAt

  @@unique([userId, date, itemKey])
  @@index([userId, date])
}

// One-off tasks with no time slot. scope "day": for one date ("Also
// today"). scope "week": for the whole ISO week, `date` is that week's
// Monday ("This week"). Unfinished ones roll over (onto today / into the
// current week) until ticked off; doneOn records the day that happened.
model ExtraTask {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      String // ISO date it was added for (week scope: that week's Monday)
  scope     String   @default("day") // "day" | "week"
  label     String
  doneOn    String? // ISO date it was ticked off
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([userId, doneOn])
}

// A custom weekly or monthly goal, separate from the routine-derived
// weekly targets (lib/checklist/goals.ts), which are computed from
// RoutineItem.days rather than stored. scope "week": period is an ISO
// week key ("2026-W45"). scope "month": period is a calendar month key
// ("2026-11"). Ticked up to `target` (default 1, i.e. a plain milestone).
model Goal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  scope     String // "week" | "month"
  period    String
  title     String
  target    Int      @default(1)
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, scope, period])
}
